# ============================================
# DataCenter — Environment Configuration
# ============================================
# Copy to .env and fill in real values

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datacenter
POSTGRES_USER=dcadmin
POSTGRES_PASSWORD=change_me_strong_password_123

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password_456

# ── Backend ──
NODE_ENV=production
API_PORT=4000
JWT_SECRET=change_me_jwt_secret_64_chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Rate Limits ──
RESET_COOLDOWN_SEC=60
RESET_MAX_PER_HOUR=10
RESET_MAX_PER_DAY_USER=200
MAX_CONNECTIONS_PER_PROXY=20
MAX_CONNECTIONS_PER_USER=200

# ── Router Defaults ──
ROUTER_SSH_PORT=22
ROUTER_SSH_TIMEOUT=10000
ROUTER_SSH_RETRIES=3
ROUTER_DEFAULT_TYPE=openwrt

# ── Health Check ──
HEALTH_CHECK_INTERVAL_SEC=120
HEALTH_CHECK_BATCH_SIZE=10

# ── Proxy ──
PROXY_HOST=proxy
PROXY_PORT_START=3001
PROXY_PORT_END=3050
PROXY_AUTH_USER=proxyuser
PROXY_AUTH_PASS=proxypass123

# ── Logging ──
LOG_LEVEL=info
LOG_RETENTION_DAYS=90

# ── Frontend ──
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
